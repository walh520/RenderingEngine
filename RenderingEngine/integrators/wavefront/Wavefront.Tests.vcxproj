  <Target Name="ValidateL7ShaderToolchain" BeforeTargets="CompileL7Shaders" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(VULKAN_SDK)' == ''" Text="VULKAN_SDK is not set; L7 shader compilation cannot run." />
    <Error Condition="!Exists('$(L7DxcExecutable)')" Text="DXC was not found at $(L7DxcExecutable)." />
    <Error Condition="!Exists('$(L7SpirvValExecutable)')" Text="spirv-val was not found at $(L7SpirvValExecutable)." />
  </Target>
  <Target Name="CompileL7Shaders" BeforeTargets="ClCompile" DependsOnTargets="ValidateL7ShaderToolchain" Inputs="@(L7Shader);@(L7ShaderDependency);$(MSBuildProjectFullPath)" Outputs="@(L7Shader->'$(L7ShaderOutputDir)%(OutputFile)')" Condition="'$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(L7ShaderOutputDir)" />
    <Exec Command="&quot;$(L7DxcExecutable)&quot; -spirv -fspv-target-env=vulkan1.3 -fvk-use-dx-layout -Ges -WX -HV 2021 -T cs_6_6 -E %(L7Shader.EntryPoint) -I &quot;$(MSBuildProjectDirectory)\shaders&quot; -I &quot;$(RenderingEngineSourceRoot)resources\shaders\integrators&quot; -I &quot;$(RenderingEngineSourceRoot)resources\shaders&quot; -Fo &quot;$(L7ShaderOutputDir)%(L7Shader.OutputFile)&quot; &quot;%(L7Shader.FullPath)&quot;" />
    <Exec Command="&quot;$(L7SpirvValExecutable)&quot; --target-env vulkan1.3 &quot;$(L7ShaderOutputDir)%(L7Shader.OutputFile)&quot;" />
  </Target>
  <Target Name="CleanL7ShaderOutputs" AfterTargets="Clean">
    <Delete Files="@(L7Shader->'$(L7ShaderOutputDir)%(OutputFile)')" />
  </Target>
