#ifndef RENDERING_ENGINE_ABI_VERSION_V3_HLSLI
#define RENDERING_ENGINE_ABI_VERSION_V3_HLSLI

// Human-facing contract name: abi-v3. Numeric values are append-only:
// abi-v0 = 1, abi-v1 = 2, abi-v2 = 3, and zero is reserved for
// uninitialized data.
static const uint kAbiVersionV3 = 4u;
static const uint kInvalidIdV3 = 0xffffffffu;

#endif
