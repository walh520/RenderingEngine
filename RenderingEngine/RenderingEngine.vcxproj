<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Compatibility entry point for old Visual Studio recent-project records.
       The authoritative executable project is RenderingEngine.Vulkan.vcxproj.
       Importing it here prevents F5 from rebuilding or launching the retired
       Wave 0/OpenGL target under the same project GUID and display name. -->
  <Import Project="RenderingEngine.Vulkan.vcxproj" />
  <PropertyGroup>
    <!-- Avoid sharing compiler tracking files when both project names have
         been opened from Visual Studio's recent-project list. -->
    <IntDir>$(RenderingEngineRepositoryRoot)build\$(Platform)\$(Configuration)\RenderingEngine.Compatibility\</IntDir>
    <IntermediateOutputPath>$(IntDir)</IntermediateOutputPath>
    <TLogLocation>$(IntDir)$(ProjectName).tlog\</TLogLocation>
    <LastBuildState>$(TLogLocation)$(ProjectName).lastbuildstate</LastBuildState>
    <LastBuildUnsuccessful>$(TLogLocation)unsuccessfulbuild</LastBuildUnsuccessful>
  </PropertyGroup>
</Project>
