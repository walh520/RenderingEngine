  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets" Condition="Exists('$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets')" />
  <PropertyGroup>
    <PinnedMinizBinSubdir Condition="'$(Configuration)'=='Debug'">debug\bin\</PinnedMinizBinSubdir>
    <PinnedMinizBinSubdir Condition="'$(PinnedMinizBinSubdir)'==''">bin\</PinnedMinizBinSubdir>
    <PinnedMinizRuntime>$(VcpkgInstalledDir)$(VcpkgTriplet)\$(PinnedMinizBinSubdir)miniz.dll</PinnedMinizRuntime>
    <PinnedGlfwRuntime>$(VcpkgInstalledDir)$(VcpkgTriplet)\$(PinnedMinizBinSubdir)glfw3.dll</PinnedGlfwRuntime>
  </PropertyGroup>
  <!-- Several manifest consumers intentionally share OutDir. Their independent
       vcpkg clean/write logs can remove a DLL copied by an earlier project.
       Reassert this executable's direct runtime dependency after all of its
       ordinary Build targets; do not rely on a prior project's app-local copy. -->
  <Target Name="EnsureRenderingEngineMinizRuntime" AfterTargets="Build">
    <Error Condition="!Exists('$(PinnedMinizRuntime)')"
           Text="Pinned miniz runtime was not found at $(PinnedMinizRuntime)." />
    <Error Condition="!Exists('$(PinnedGlfwRuntime)')"
           Text="Pinned GLFW runtime was not found at $(PinnedGlfwRuntime)." />
    <Copy SourceFiles="$(PinnedMinizRuntime)"
          DestinationFiles="$(OutDir)miniz.dll"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PinnedGlfwRuntime)"
          DestinationFiles="$(OutDir)glfw3.dll"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="Wave1RequireVcpkg" BeforeTargets="PrepareForBuild" Condition="!Exists('$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.props')">
    <Error Text="Wave 1 GLFW composition requires the pinned vcpkg integration. Pass /p:VcpkgRoot=&lt;path&gt;." />
  </Target>
  <Import Project="msbuild\VulkanShaders.targets" />
  <PropertyGroup>
    <!-- VS may retain an old executable path in its private .suo even after the
         project is corrected. Keep that retired path as a byte-for-byte Wave 5
         runtime mirror so it can never launch the Wave 0 executable again. -->
    <LegacyVisualStudioOutDir>$(MSBuildProjectDirectory)\bin\$(Platform)\$(Configuration)\</LegacyVisualStudioOutDir>
  </PropertyGroup>
  <Target Name="MirrorWave5RuntimeForLegacyVisualStudioPath" AfterTargets="Build">
    <Error Condition="!Exists('$(OutDir)RenderingEngine.exe')"
           Text="Wave 5 executable was not produced at $(OutDir)RenderingEngine.exe." />
    <MakeDir Directories="$(LegacyVisualStudioOutDir)" />
    <ItemGroup>
      <Wave5LegacyMirrorFile Include="$(OutDir)RenderingEngine.exe" />
      <Wave5LegacyMirrorFile Include="$(OutDir)RenderingEngine.pdb"
                             Condition="Exists('$(OutDir)RenderingEngine.pdb')" />
      <Wave5LegacyMirrorFile Include="$(OutDir)*.dll" />
      <Wave5LegacyMirrorFile Include="$(OutDir)*.spv" />
    </ItemGroup>
    <Copy SourceFiles="@(Wave5LegacyMirrorFile)"
          DestinationFolder="$(LegacyVisualStudioOutDir)"
          SkipUnchangedFiles="true" />
    <Message Importance="High"
             Text="Wave 5 VS launch mirror: $(LegacyVisualStudioOutDir)RenderingEngine.exe" />
  </Target>
  <ImportGroup Label="ExtensionTargets" />
</Project>
