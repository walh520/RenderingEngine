    <ClCompile Include="tests\ReconstructionTests.cpp" />
    <ClCompile Include="tests\VulkanReconstructionRecorderTests.cpp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="shaders\ReconstructionCommon.hlsli" />
    <None Include="shaders\MotionVectorsCS.hlsl" />
    <None Include="shaders\PrepareSignalCS.hlsl" />
    <None Include="shaders\TemporalAccumulationCS.hlsl" />
    <None Include="shaders\VarianceBootstrapCS.hlsl" />
    <None Include="shaders\ATrousCS.hlsl" />
    <None Include="shaders\ComposeCS.hlsl" />
  </ItemGroup>
  <ItemGroup>
    <L8Shader Include="shaders\MotionVectorsCS.hlsl"><OutputFile>motion_vectors.spv</OutputFile></L8Shader>
    <L8Shader Include="shaders\PrepareSignalCS.hlsl"><OutputFile>prepare_signal.spv</OutputFile></L8Shader>
    <L8Shader Include="shaders\TemporalAccumulationCS.hlsl"><OutputFile>temporal_accumulation.spv</OutputFile></L8Shader>
    <L8Shader Include="shaders\VarianceBootstrapCS.hlsl"><OutputFile>variance_bootstrap.spv</OutputFile></L8Shader>
    <L8Shader Include="shaders\ATrousCS.hlsl"><OutputFile>atrous.spv</OutputFile></L8Shader>
    <L8Shader Include="shaders\ComposeCS.hlsl"><OutputFile>compose.spv</OutputFile></L8Shader>
    <L8ShaderDependency Include="shaders\ReconstructionCommon.hlsli" />
    <L8ShaderDependency Include="..\resources\shaders\include\contracts\*.hlsli" />
  </ItemGroup>
  <Target Name="ValidateL8ShaderToolchain" BeforeTargets="CompileL8Shaders" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(VULKAN_SDK)' == ''" Text="VULKAN_SDK is not set; L8 shader compilation cannot run." />
    <Error Condition="!Exists('$(L8DxcExecutable)')" Text="DXC was not found at $(L8DxcExecutable)." />
    <Error Condition="!Exists('$(L8SpirvValExecutable)')" Text="spirv-val was not found at $(L8SpirvValExecutable)." />
  </Target>
  <Target Name="CompileL8Shaders" BeforeTargets="ClCompile" DependsOnTargets="ValidateL8ShaderToolchain"
          Inputs="@(L8Shader);@(L8ShaderDependency);$(MSBuildProjectFullPath)"
          Outputs="@(L8Shader->'$(L8ShaderOutputDir)%(OutputFile)')"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(L8ShaderOutputDir)" />
    <Exec Command="&quot;$(L8DxcExecutable)&quot; -spirv -fspv-target-env=vulkan1.3 -fvk-use-dx-layout -Ges -WX -HV 2021 -T cs_6_6 -E main -Fo &quot;$(L8ShaderOutputDir)%(L8Shader.OutputFile)&quot; &quot;%(L8Shader.FullPath)&quot;" />
    <Exec Command="&quot;$(L8SpirvValExecutable)&quot; --target-env vulkan1.3 &quot;$(L8ShaderOutputDir)%(L8Shader.OutputFile)&quot;" />
  </Target>
  <Target Name="CleanL8ShaderOutputs" AfterTargets="Clean">
    <Delete Files="@(L8Shader->'$(L8ShaderOutputDir)%(OutputFile)')" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
