  <PropertyGroup>
    <OutDir>$(MSBuildProjectDirectory)\build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\build\obj\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>RenderingEngine.Wave2TraversalGate</TargetName>
    <VcpkgEnableManifest>false</VcpkgEnableManifest>
    <Wave2ShaderDir>$(OutDir)shaders\</Wave2ShaderDir>
    <Wave2Dxc>$(VULKAN_SDK)\Bin\dxc.exe</Wave2Dxc>
    <Wave2SpirvVal>$(VULKAN_SDK)\Bin\spirv-val.exe</Wave2SpirvVal>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(RenderingEngineSourceRoot);$(RenderingEngineSourceRoot)rt\hardware\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>VK_ENABLE_BETA_EXTENSIONS;_CONSOLE;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(VULKAN_SDK)\Lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>vulkan-1.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>Console</SubSystem>
