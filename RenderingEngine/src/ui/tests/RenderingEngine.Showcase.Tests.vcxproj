  <PropertyGroup>
    <PinnedMinizBinSubdir Condition="'$(Configuration)'=='Debug'">debug\bin\</PinnedMinizBinSubdir>
    <PinnedMinizBinSubdir Condition="'$(PinnedMinizBinSubdir)'==''">bin\</PinnedMinizBinSubdir>
    <PinnedMinizRuntime>$(VcpkgInstalledDir)$(VcpkgTriplet)\$(PinnedMinizBinSubdir)miniz.dll</PinnedMinizRuntime>
  </PropertyGroup>
  <!-- This test executable shares OutDir with other manifest consumers. Copy
       its direct runtime dependency after Build so another project's stale
       app-local clean record cannot leave a successful but unrunnable binary. -->
  <Target Name="EnsureShowcaseTestsMinizRuntime" AfterTargets="Build">
    <Error Condition="!Exists('$(PinnedMinizRuntime)')"
           Text="Pinned miniz runtime was not found at $(PinnedMinizRuntime)." />
    <Copy SourceFiles="$(PinnedMinizRuntime)"
          DestinationFiles="$(OutDir)miniz.dll"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="L10RequireVcpkg" BeforeTargets="PrepareForBuild" Condition="!Exists('$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.props')">
    <Error Text="L10 showcase tests require vcpkg. Pass /p:VcpkgRoot=&lt;path&gt; or install the Visual Studio vcpkg component." />
  </Target>
